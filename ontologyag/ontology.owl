<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
]>

<rdf:RDF xmlns="http://tyqy.com/wind-solar/0.1#"
     xml:base="http://tyqy.com/wind-solar/0.1"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">

    <!-- 定义类 -->
    <owl:Class rdf:about="#Person"/> <!-- 人 -->
    <owl:Class rdf:about="#Location"/> <!-- 地点 -->
    <owl:Class rdf:about="#Event"/> <!-- 事件 -->
    <owl:Class rdf:about="#Organization"/> <!-- 组织机构 -->
    <owl:Class rdf:about="#Equipment"/> <!-- 设备 -->
    <owl:Class rdf:about="#FaultType"/> <!-- 故障类型 -->
    <owl:Class rdf:about="#MaintenanceStrategy"/> <!-- 维护策略 -->
    <owl:Class rdf:about="#PerformanceIndicator"/> <!-- 性能指标 -->
    <owl:Class rdf:about="#MeteorologicalCondition"/> <!-- 气象条件 -->
    <owl:Class rdf:about="# ">
        <rdfs:subClassOf rdf:resource="#SafetyStandard"/>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#SafetyViolation"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    
    <owl:Class rdf:about="#SafetyViolation">
        <rdfs:subClassOf rdf:resource="#SafetyStandard"/>
    </owl:Class>
    
    <owl:DatatypeProperty rdf:about="#hasViolationType">
        <rdfs:domain rdf:resource="#SafetyViolation"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    <owl:Class rdf:about="#TechnicalParameter"/> <!-- 技术参数 -->
    <owl:Class rdf:about="#CostInformation"/> <!-- 成本信息 -->

    <!-- 定义属性 -->
    <owl:DatatypeProperty rdf:about="#hasName"> <!-- 人物具有名称 -->
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hasAddress"> <!-- 地点具有地址 -->
        <rdfs:domain rdf:resource="#Location"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hasDate"> <!-- 事件具有日期 -->
        <rdfs:domain rdf:resource="#Event"/>
        <rdfs:range rdf:resource="&xsd;date"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hasRevenue"> <!-- 成本信息具有收益 -->
        <rdfs:domain rdf:resource="#CostInformation"/>
        <rdfs:range rdf:resource="&xsd;float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hasPower"> <!-- 技术参数具有功率 -->
        <rdfs:domain rdf:resource="#TechnicalParameter"/>
        <rdfs:range rdf:resource="&xsd;float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hasTemperature"> <!-- 气象条件具有温度 -->
        <rdfs:domain rdf:resource="#MeteorologicalCondition"/>
        <rdfs:range rdf:resource="&xsd;float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hasEfficiency"> <!-- 性能指标具有效率 -->
        <rdfs:domain rdf:resource="#PerformanceIndicator"/>
        <rdfs:range rdf:resource="&xsd;float"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#hasSafetyLevel"> <!-- 安全规范具有安全等级 -->
        <rdfs:domain rdf:resource="#SafetyStandard"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>

    <!-- 维修要素类 -->
    <owl:Class rdf:about="#RepairTool"/>
    <owl:Class rdf:about="#RepairStep"/>

    <!-- 维修要素属性 -->
    <owl:DatatypeProperty rdf:about="#toolName">
        <rdfs:domain rdf:resource="#RepairTool"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#stepDescription">
        <rdfs:domain rdf:resource="#RepairStep"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>

    <!-- 定义关系 -->
    <owl:ObjectProperty rdf:about="#isLocatedIn"> <!-- 设备位于某个地点 -->
        <rdfs:domain rdf:resource="#Equipment"/>
        <rdfs:range rdf:resource="#Location"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isMaintainedBy"> <!-- 设备由某个组织机构维护 -->
        <rdfs:domain rdf:resource="#Equipment"/>
        <rdfs:range rdf:resource="#Organization"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#causes"> <!-- 故障类型导致某个事件 -->
        <rdfs:domain rdf:resource="#FaultType"/>
        <rdfs:range rdf:resource="#Event"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#requiresTool">
        <rdfs:domain rdf:resource="#FaultType"/>
        <rdfs:range rdf:resource="#RepairTool"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#requiresStep">
        <rdfs:domain rdf:resource="#FaultType"/>
        <rdfs:range rdf:resource="#RepairStep"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#requires"> <!-- 故障类型需要某种维护策略 -->
        <rdfs:domain rdf:resource="#FaultType"/>
        <rdfs:range rdf:resource="#MaintenanceStrategy"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#affects"> <!-- 气象条件影响性能指标 -->
        <rdfs:domain rdf:resource="#MeteorologicalCondition"/>
        <rdfs:range rdf:resource="#PerformanceIndicator"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isCompliantWith"> <!-- 设备符合某个安全规范 -->
        <rdfs:domain rdf:resource="#Equipment"/>
        <rdfs:range rdf:resource="#SafetyStandard"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isRelatedTo">
        <rdfs:domain rdf:resource="#CostInformation"/>
        <rdfs:range rdf:resource="#MaintenanceStrategy"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#hasRepairProcedure">
        <rdfs:domain rdf:resource="#Equipment"/>
        <rdfs:range rdf:resource="#RepairStep"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#isParameterOf">
        <rdfs:domain rdf:resource="#TechnicalParameter"/>
        <rdfs:range rdf:resource="#Equipment"/>
    </owl:ObjectProperty>

    <!-- 新增设备分类体系 -->
    <owl:Class rdf:about="#WindPowerEquipment">
        <rdfs:subClassOf rdf:resource="#Equipment"/>
    </owl:Class>
    
    <owl:Class rdf:about="#PhotovoltaicEquipment">
        <rdfs:subClassOf rdf:resource="#Equipment"/>
    </owl:Class>
    
    <!-- 新增部件组成结构 -->
    <owl:Class rdf:about="#Component"/>
    <owl:ObjectProperty rdf:about="#hasPart">
        <rdfs:domain rdf:resource="#Equipment"/>
        <rdfs:range rdf:resource="#Component"/>
    </owl:ObjectProperty>
    
    <!-- 新增技术参数子类 -->
    <owl:Class rdf:about="#RatedPower">
        <rdfs:subClassOf rdf:resource="#TechnicalParameter"/>
    </owl:Class>
    
    <owl:Class rdf:about="#ConversionEfficiency">
        <rdfs:subClassOf rdf:resource="#TechnicalParameter"/>
    </owl:Class>

    <!-- 新增安装维护体系 -->
    <owl:Class rdf:about="#InstallationStep"/>
    <owl:Class rdf:about="#SafetyGear"/>
    <owl:Class rdf:about="#InspectionProcedure"/>
    
    <!-- 新增安装相关属性 -->
    <owl:ObjectProperty rdf:about="#hasInstallationStep">
        <rdfs:domain rdf:resource="#Equipment"/>
        <rdfs:range rdf:resource="#InstallationStep"/>
    </owl:ObjectProperty>
    
    <owl:DatatypeProperty rdf:about="#hasToolRequirement">
        <rdfs:domain rdf:resource="#InstallationStep"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    
    <!-- 新增安全穿戴检查 -->
    <owl:DatatypeProperty rdf:about="#hasCheckParameter">
        <rdfs:domain rdf:resource="#InspectionProcedure"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    
    <owl:ObjectProperty rdf:about="#checksSafetyGear">
        <rdfs:domain rdf:resource="#InspectionProcedure"/>
        <rdfs:range rdf:resource="#SafetyGear"/>
    </owl:ObjectProperty>
    
    <!-- 新增巡检相关属性 -->
    <owl:DatatypeProperty rdf:about="#hasFrequency">
        <rdfs:domain rdf:resource="#InspectionProcedure"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    
    <owl:ObjectProperty rdf:about="#requiresInspection">
        <rdfs:domain rdf:resource="#Equipment"/>
        <rdfs:range rdf:resource="#InspectionProcedure"/>
    </owl:ObjectProperty>
    
    <!-- 扩展维护策略 -->
    <owl:Class rdf:about="#MaintenanceStrategy">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#InstallationStrategy"/>
                    <owl:Class rdf:about="#SafetyProcedure"/>
                    <owl:Class rdf:about="#InspectionProtocol"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- 新增课程体系 -->
    <owl:Class rdf:about="#Course"/>
    <owl:ObjectProperty rdf:about="#hasSubcourse">
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="#Course"/>
    </owl:ObjectProperty>
    
    <!-- 基础属性 -->
    <owl:DatatypeProperty rdf:about="#courseName">
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#courseDescription">
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#difficultyLevel">
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#courseLink">
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="&xsd;anyURI"/>
    </owl:DatatypeProperty>
    
    <!-- 泛化关联属性优化 -->
    <owl:ObjectProperty rdf:about="#coversKnowledge">
        <rdfs:domain rdf:resource="#Course"/>
        <rdfs:range rdf:resource="&owl;Thing"/>
    </owl:ObjectProperty>
    
    <!-- 课程实例示例 -->
    <owl:NamedIndividual rdf:about="#GeneralSafetyCourse">
        <rdf:type rdf:resource="#Course"/>
        <courseName>通用安全规范课程</courseName>
        <difficultyLevel>中级</difficultyLevel>
        <coversKnowledge rdf:resource="#SafetyGear"/>
        <coversKnowledge rdf:resource="#InspectionProtocol"/>
        <hasSubcourse>
            <owl:NamedIndividual rdf:about="#EquipmentInstallationSubcourse">
                <rdf:type rdf:resource="#Course"/>
                <courseDescription>设备安装标准流程教学</courseDescription>
                <coversKnowledge rdf:resource="#InstallationStep"/>
            </owl:NamedIndividual>
        </hasSubcourse>
    </owl:NamedIndividual>
</rdf:RDF>